# ─────────────────────────────────────────────────────────────────────────────
# Digital Counterpart — copy to `.env.local` and fill in.
#
# Keep BM25 retrieval and evidence verification. Enable the checked LLM voice
# for natural answers; credentials belong in the secret store.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Evidence verifier ─────────────────────────────────────────────────────
# LLM_PROVIDER is the backward-compatible default for the verifier role.
# Production REQUIRES both explicit role variables, credentials, and enabled
# verification. No compiled model default is accepted at production startup.
# Providers: google | anthropic | openai | azure
LLM_VERIFIER_PROVIDER=

# Set an evaluated model ID, or an Azure deployment name for provider=azure.
LLM_VERIFIER_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_VERSION=v1

# Public OpenAI is a separate provider and credential namespace. Never put an
# Azure key in OPENAI_API_KEY.
# LLM_VERIFIER_PROVIDER=openai
# LLM_VERIFIER_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=sk-...

# Other supported verifier providers:
# Passed the 2026-09-07 verification evaluation; see docs/implementation-status.md.
# LLM_VERIFIER_PROVIDER=google
# LLM_VERIFIER_MODEL=gemini-3.5-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_VERIFIER_PROVIDER=anthropic
# LLM_VERIFIER_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Semantic query recovery runs only when deterministic interaction routing is
# uncertain. It reuses the verifier provider, model, and credential by default.
# Configure a separate low-cost structured-output model only when evaluated.
LLM_INTERPRETER_ENABLED=true
# LLM_INTERPRETER_PROVIDER=google
# LLM_INTERPRETER_MODEL=<your-evaluated-model>
LLM_INTERPRETER_TIMEOUT_MS=5000

# Checked natural wording: explicitly configure both role fields to enable it.
# Reuse your evaluated verifier provider/model, or evaluate a separate writer.
# LLM_RENDERER_ENABLED=true
# LLM_RENDERER_PROVIDER=openai
# LLM_RENDERER_MODEL=<your-evaluated-model>
LLM_RENDERER_TIMEOUT_MS=20000
LLM_RENDERER_MAX_OUTPUT_TOKENS=1600
# false keeps deterministic wording without disabling evidence verification.
# LLM_RENDERER_ENABLED=false

# Reuse checked wording for equivalent approved factual plans across visitors.
# Vercel: regional Runtime Cache. Elsewhere: process-local bounded LRU.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_MS=86400000
ANSWER_CACHE_MAX_ENTRIES=1000


# ── 2. Embeddings ────────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER: none | google | voyage | openai
#
#   none    → BM25 lexical retrieval only. No extra setup, and genuinely good on
#             a corpus this small. This is the default.
#   google  → gemini-embedding-001, also free tier. Reuses the key above, so
#             turning this on costs nothing and adds semantic matching for
#             questions that don't share vocabulary with your notes
#             ("do you know frontend?" → your React notes).
#   voyage  → Anthropic's recommended embedding partner (https://voyageai.com)
#   openai  → text-embedding-3-small
#
# Re-run `npm run ingest` after changing this.
EMBEDDING_PROVIDER=none

# Google embeddings need no extra key — GOOGLE_GENERATIVE_AI_API_KEY is reused.
# gemini-embedding-001 returns 3072 dims natively; we truncate to 768 to keep
# the committed index small. Raise for a little more accuracy, at index size.
# EMBEDDING_DIMENSIONS=768

# VOYAGE_API_KEY=pa-...
# EMBEDDING_MODEL=voyage-3.5-lite


# ── 3. Vector store ──────────────────────────────────────────────────────────
# VECTOR_STORE: memory | pinecone | supabase
#
#   memory   → vectors live in `data/.index/index.json`, loaded in-process.
#              Right answer for a personal site. This is the default.
#   pinecone → serverless index over REST
#   supabase → pgvector via PostgREST (see supabase/migrations/0001_init.sql)
VECTOR_STORE=memory

# Pinecone
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX_HOST=https://my-index-abc123.svc.us-east-1-aws.pinecone.io
# PINECONE_NAMESPACE=counterpart

# Supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_TABLE=counterpart_documents


# ── 4. Abuse protection ──────────────────────────────────────────────────────
# /api/chat is public and every call spends model quota, so it is rate limited
# by default. Leave this alone unless you have a reason.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=12
# RATE_LIMIT_WINDOW_SECONDS=60
# MAX_MESSAGE_CHARS=2000
#
# Without Redis the counter lives in each server instance's memory, so on
# serverless the real limit is (requests × warm instances). Fine for a personal
# site. For a shared counter that holds across instances, add a free Upstash
# Redis database — no extra npm package needed, it's called over REST.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...


# ── 5. Contact delivery ──────────────────────────────────────────────────────
# Without one of these adapters, the same form opens a pre-addressed draft in
# the visitor's email app. It never claims that an undelivered message was sent.
#
# Recommended: Resend. Create a key at https://resend.com/api-keys
# For production, verify your domain and use an address on it as the sender.
# The resend.dev test sender can only deliver to the email on your Resend account.
# RESEND_API_KEY=re_...
# CONTACT_TO_EMAIL=admin@gauravadhikari.info.np
# CONTACT_FROM_EMAIL=GauravGPT <messages@your-verified-domain.com>
#
# Alternative: any endpoint that accepts a JSON POST (Slack, Discord, automation).
# CONTACT_WEBHOOK_URL=https://...


# ── 6. Optional ──────────────────────────────────────────────────────────────
# Public base URL, used for OG metadata and link previews.
# On Vercel this is inferred automatically; set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://gauravadhikari.info.np
# GOOGLE_SITE_VERIFICATION=...
# BING_SITE_VERIFICATION=...

# ── Online content editor (/admin) ──────────────────────────────────────────
# Create a GitHub OAuth app with callback:
# https://your-domain.example/api/auth/callback/github
# Generate AUTH_SECRET with `npx auth secret` or another secure random generator.
# Restrict sign-in to the GitHub account's numeric user ID.
# The fine-grained token should have Contents: read/write on only this repository.
# Keep every value server-side. Do not use NEXT_PUBLIC_ for these variables.
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# ADMIN_GITHUB_ID=108446217
# ADMIN_GITHUB_TOKEN=

# Optional PostHog product analytics for aggregate routing/UI quality.
# Both must be set to enable capture. Use the ingestion host for your PostHog
# region/project. The app sends only structured intent/visual/support metadata:
# no raw visitor questions, answers, emails, IP addresses, citations, or evidence.
# POSTHOG_PROJECT_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Reliability migration controls. Disabling claim verification is fail-closed:
# only deterministic exact facts remain answerable.
EVIDENCE_PIPELINE_V2=true
CLAIM_VERIFICATION=true
RERANKER=none
OBSERVABILITY_ENABLED=false

# Process-local verification LRU. Source/index and policy/model changes make
# old entries ineligible automatically. No failed provider calls are cached.
VERIFICATION_CACHE_ENABLED=true
VERIFICATION_CACHE_TTL_MS=86400000
VERIFICATION_CACHE_MAX_ENTRIES=1000
# candidateK, verificationK, concurrency and call limits: counterpart.config.ts
