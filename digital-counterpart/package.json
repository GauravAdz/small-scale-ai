{
  "name": "digital-counterpart",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive, conversational twin — a RAG-grounded AI portfolio.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint:knowledge && npm run ingest && npm run verify:index && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/lint-architecture.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "ingest:stats": "tsx --env-file-if-exists=.env.local scripts/ingest.ts --stats",
    "verify:index": "tsx --env-file-if-exists=.env.local scripts/verify-index.ts",
    "lint:knowledge": "tsx scripts/lint-knowledge.ts",
    "ask": "node scripts/verification/paid.mjs ask",
    "smoke:azure": "node scripts/verification/paid.mjs azure",
    "bench": "tsx --env-file-if-exists=.env.local scripts/bench.ts",
    "bench:live": "node scripts/verification/paid.mjs latency",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run tests/property",
    "test:e2e": "npm run test:ui --",
    "eval:retrieval": "tsx --env-file-if-exists=.env.local scripts/eval-retrieval.ts",
    "eval:support": "tsx --env-file-if-exists=.env.local scripts/eval-support.ts",
    "eval:answer": "tsx --env-file-if-exists=.env.local scripts/eval-answer.ts",
    "eval:citations": "tsx --env-file-if-exists=.env.local scripts/eval-citations.ts",
    "eval:conversation": "tsx --env-file-if-exists=.env.local scripts/eval-conversation.ts",
    "eval:operations": "tsx --env-file-if-exists=.env.local scripts/eval-operations.ts",
    "eval:models": "node scripts/verification/paid.mjs models",
    "eval:natural": "node scripts/verification/paid.mjs natural",
    "eval:all": "npm run eval:retrieval && npm run eval:support && npm run eval:answer && npm run eval:citations && npm run eval:conversation && npm run eval:operations",
    "verify": "node scripts/verification/run.mjs",
    "verify:plan": "node scripts/verification/run.mjs --plan",
    "test:verification": "node --test tests/verification/*.test.mjs",
    "test:ui": "playwright test --config=playwright.config.ts",
    "test:live": "node scripts/verification/paid.mjs browser"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/azure": "^4.0.61",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/react": "^4.0.69",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
